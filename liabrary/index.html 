<!doctype html><html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>StarHub Library - YouTube Library</title><link rel="icon" href="/favicon.ico"/><link rel="manifest" href="/manifest.json"/><style>body{margin:0;background:#000;color:#fff;font-family:system-ui}header{padding:12px;background:#111;position:sticky;top:0}.tabs{display:flex;gap:8px;overflow:auto;padding:8px 12px}button{background:#222;border:1px solid #333;color:#fff;border-radius:999px;padding:8px 12px}.grid{padding:12px}.card{padding:10px;border-bottom:1px solid #222;display:flex;gap:10px}</style></head><body>
<header><button onclick="history.back()">←</button> Library - YouTube Style - History + Watch Later + Likes + Save + Playlist + Recent History + Stats</header>
<div class="tabs"><button>History</button><button>Watch Later</button><button>Likes</button><button>Save</button><button>Playlist</button><button>Recent History</button><button>For you</button><button>Your Taste</button></div>
<div id="grid" class="grid"></div>
<script type="module">
import {getStore} from '/lib/storage.js';const S=getStore();
function load(){try{const h=JSON.parse(S.getItem('starhub_history')||'[]');const w=JSON.parse(S.getItem('starhub_watch_later')||'[]');const l=JSON.parse(S.getItem('starhub_likes')||'[]');const all=[...new Set([...h,...w,...l])];document.getElementById('grid').innerHTML=(all.length?all:['auto','piped','searx','122','133']).map(id=>`<div class="card" onclick="location.href='/watch/?v=${id}'"><img src="/api/thumbnail?id=${id}&w=200" width="80" style="border-radius:8px"><div><b>${id}</b><br><small>History • Watch Later • Likes • Save • Playlist • Recent • For you Your Taste Your Subscriptions • Taste user picks • Your Taste badge • For you = Your Taste + Your Subscriptions • All subscriptions Most relevant bell on/off</small></div></div>`).join('');}catch(e){document.getElementById('grid').innerHTML=`Fallback ${e.message}`;}}
load();
</script></body></html>