<!doctype html><html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>StarHub Store Search - Play Store</title><link rel="icon" href="/favicon.ico"/><link rel="manifest" href="/manifest.json"/><style>body{margin:0;background:#000;color:#fff;font-family:system-ui}header{position:sticky;top:0;background:#111;padding:10px 12px;display:flex;gap:8px;z-index:10}input{flex:1;background:#222;border:0;border-radius:999px;padding:10px 14px;color:#fff}.card{padding:12px;border-bottom:1px solid #222;display:flex;gap:12px}.card img{width:72px;height:72px;border-radius:20px;background:#222}.grid{padding:12px}button{background:#222;border:1px solid #333;color:#fff;border-radius:999px;padding:8px 12px}</style></head><body>
<header><button onclick="location.href='/'">←</button><input id="q" placeholder="Search apps games..."/><button>Search</button></header><div style="padding:12px;opacity:.7;font-size:12px">Play Store /store/search?q= - For you Top charts Children Premium - Sponsored Suggested - Coming soon Install 4.3★ 121MB</div><div id="grid" class="grid"></div>
<script type="module">
import {getStore} from '/lib/storage.js';const qq=new URLSearchParams(location.search).get('q')||'';document.getElementById('q').value=qq;
async function load(q){const r=await fetch(`/api/search?q=${encodeURIComponent(q||'')}`);const j=await r.json();document.getElementById('grid').innerHTML=(j.results||[]).map(x=>`<div class="card" onclick="location.href='/store/apps/details/?id=${x.id}'"><img src="/api/thumbnail?id=${x.id}&w=200"><div><b>${x.id}</b><br><small>4.3★ • 121MB • Install • ${x.type||'app'}</small><br><small>Dev upload style • Managed publishing timed publish • Rollback staged 10% 50% 100%</small></div><button>Install</button></div>`).join('');}
document.getElementById('q').addEventListener('input',e=>{const v=e.target.value;history.replaceState({},'','/store/search/?q='+encodeURIComponent(v));load(v);});load(qq);
</script></body></html>