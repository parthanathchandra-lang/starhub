<!doctype html><html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>StarHub Results - YouTube Style</title><link rel="icon" href="/favicon.ico"/><link rel="manifest" href="/manifest.json"/><style>body{margin:0;background:#000;color:#fff;font-family:system-ui}header{position:sticky;top:0;background:#111;padding:10px 12px;display:flex;gap:8px;z-index:10}input{flex:1;background:#222;border:0;border-radius:999px;padding:10px 14px;color:#fff}.card{contain:strict;padding:12px;border-bottom:1px solid #222;display:flex;gap:12px}.card img{width:160px;aspect-ratio:16/9;border-radius:12px;background:#222}.grid{padding:12px}.chips{display:flex;gap:8px;overflow:auto;padding:8px 12px}button{background:#222;border:1px solid #333;color:#fff;border-radius:999px;padding:8px 12px}</style></head><body>
<header><button onclick="location.href='/'">←</button><input id="q" placeholder="Search YouTube style..."/><button onclick="location.href='/library/'">Library</button></header><div class="chips"><button>All</button><button>Today</button><button>Videos</button><button>Shorts</button><button>Live</button><button>Most relevant</button></div><div id="meta" style="padding:0 12px;opacity:.7;font-size:12px">YouTube /results?search_query= - GENIUS WAIFU 22:02 9.6k views</div><div id="grid" class="grid"></div>
<script type="module">
import FM from '/lib/feature-manager.js';import {getStore,saveHistory} from '/lib/storage.js';
const S=getStore();const qq=new URLSearchParams(location.search).get('q')||new URLSearchParams(location.search).get('search_query')||'';document.getElementById('q').value=qq;
document.getElementById('q').addEventListener('input',e=>{const v=e.target.value;history.replaceState({},'','/results/?search_query='+encodeURIComponent(v));saveHistory(v);load(v);});
async function load(q){try{const r=await fetch(`/api/search?q=${encodeURIComponent(q||'')}`);const j=await r.json();document.getElementById('grid').innerHTML=(j.results||[]).map(x=>`<div class="card" onclick="location.href='/watch/?v=${x.id}'"><img src="/api/thumbnail?id=${x.id}&w=200" loading="lazy"><div><b>${x.name||x.id} - GENIUS 22:02</b><br><small>9.6k views • free safe legal • ${x.type||'youtube'} • ${FM.getStatus().version}</small><br><small>Shorts horizontal • Round avatars • Chips • Bottom Home Shorts Subscriptions You</small></div></div>`).join('');}catch(e){document.getElementById('grid').innerHTML=`Fallback ${e.message}`;}}
load(qq);
</script></body></html>