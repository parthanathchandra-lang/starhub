<!DOCTYPE html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>StarHub igdp - Honest Build</title>
<style>
:root{--bg:#fff;--card:#f8f9fb;--line:#e3e5ec;--neon:#00b368;--purp:#8b5cf6;--text:#5b5f70;--chip:#eef0f6}
*{box-sizing:border-box;margin:0;padding:0}body{background:var(--bg);color:#12131a;font-family:Inter,system-ui}
header{position:fixed;top:0;left:0;right:0;height:56px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:10px;padding:0 14px;z-index:100}
.logo{font-weight:700;font-size:20px}.logo b{color:var(--neon)}
.search{flex:1;max-width:680px;display:flex;align-items:center;gap:8px;background:#f0f1f6;border:1px solid var(--line);border-radius:24px;padding:8px 14px;position:relative}
.search input{flex:1;background:transparent;border:0;outline:none}
.pill{padding:6px 12px;border-radius:20px;background:var(--chip);border:1px solid var(--line);font-size:12px;cursor:pointer}
.pill.on{background:var(--neon);color:#fff}
.catBar{position:fixed;top:56px;left:0;right:0;height:44px;background:#fff;border-bottom:1px solid var(--line);display:flex;gap:8px;padding:0 14px;overflow-x:auto;z-index:90}
#wrap{margin:100px auto;max-width:1280px;padding:12px}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px;margin:12px 0}
.masonry{column-count:4;column-gap:12px}
@media(max-width:700px){.masonry{column-count:1}}
.psBox{break-inside:avoid;background:#fff;border:1px solid var(--line);border-radius:16px;padding:10px;margin-bottom:12px}
.badge{font-size:9px;padding:3px 7px;border-radius:20px;background:#00b36822;border:1px solid #00b36844}
.badge.paid{background:#8b5cf622}
.btn{padding:8px;border-radius:20px;border:0;font-weight:700;cursor:pointer;margin-top:6px;font-size:12px;width:100%}
.direct{background:var(--neon);color:#fff}
.note{font-size:11px;color:var(--text)}
.legal{font-size:10px;color:#777;border:1px dashed #ccc;padding:10px;border-radius:10px;background:#fff}
.iframeBox{width:100%;height:65vh;border:0;background:#000;border-radius:14px;margin-top:10px}
.searchDrop{position:absolute;top:44px;left:0;right:0;background:#fff;border:1px solid var(--line);border-radius:12px;padding:8px;display:none;z-index:200}
</style></head><body>
<header><div class="logo">✦ <b>STARHUB</b> igdp</div>
<div class="search" id="searchBox">🔍<input id="q" placeholder="Search games, videos, Play Store..." oninput="onSearchInput()" onfocus="showDrop()"><div id="searchDrop" class="searchDrop"></div></div>
<span id="authStatus" class="pill">🟢 Guest</span><button onclick="loginOwner()" class="pill" style="background:#111;color:#fff">👤 Google Login + Drive</button>
</header>
<div class="catBar" id="catRow"></div>
<div id="wrap">

<div class="card" style="border-color:var(--neon)">
<h3>⚡ Honest: Fast site via Cloudflare 330+ edge • Game ping = now.gg/YouTube • No own tower boost</h3>
<div class="legal">Tower boost fake hai. Real smooth = Auto quality + nearest server + your WiFi. 1 IndexedDB (60% free) + Drive 15GB per login real.</div>
</div>

<div class="card"><h3 id="listTitle">📌 All - Related: Cloud + Play Store + YouTube</h3><div id="masonryGrid" class="masonry"></div></div>

<div class="card" id="detailSection" style="display:none"></div>

<!-- STORAGE PANEL - jo manga tha -->
<div class="card" id="userStoragePanel">
<h3>👤 My Storage Management - Real</h3>
<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px;margin-top:10px">
<div style="background:#fff;border:1px solid #e3e5ec;border-radius:12px;padding:10px"><b>📱 Device Cache</b><br><span id="deviceQuota" class="note">Checking...</span><br><span class="badge">Temp - Auto clear</span></div>
<div style="background:#e7fbf2;border:1px solid #00b368;border-radius:12px;padding:10px"><b>☁️ Linked Drive</b><br><span id="driveAccounts">No account</span><br><div id="driveTotal" class="note">Total: 0GB</div><button onclick="loginOwner()" class="btn direct">+ Add Account = +15GB</button></div>
<div style="background:#fff;border:1px dashed #ccc;border-radius:12px;padding:10px"><b>🔗 Sync Link</b><br><a id="driveLink" href="https://drive.google.com" target="_blank">View /StarHub-Cloud</a><br><span class="note">Real: fileId saved in 1 IndexedDB store drive-links</span></div>
</div></div>

<div class="card">
<h3>🔍 Player + Quality + Data Saver (YouTube style)</h3>
<div style="display:flex;gap:6px;margin:10px 0;flex-wrap:wrap">
<select id="qualitySel" onchange="setQuality(this.value)" class="pill"><option value="auto">🔄 Auto</option><option value="1080">1080p - 3GB/hr</option><option value="720">720p - 1.5GB/hr</option><option value="480">480p Data Saver - 0.7GB/hr</option><option value="240">240p Ultra Saver - 0.3GB/hr</option></select>
<select id="graphicsSel" onchange="setGraphics(this.value)" class="pill"><option value="balanced">⚖️ Balanced</option><option value="performance">⚡ Performance Low Lag</option><option value="quality">🎨 Quality High</option></select>
<span class="pill" onclick="toggleDataSaver()" id="dataSaverBtn">📉 Data Saver: Off</span>
<span class="pill" onclick="toggleMute()" id="adsToggle">🔊 Ads On</span>
</div>
<div id="dataInfo" class="note">Quality auto by your network - tower boost nahi, quality switch real</div>
<div id="player" style="display:none;margin-top:12px"><b id="pTitle"></b><div id="topAds" class="note">📢 Ad by provider (now.gg/YouTube)</div><iframe id="frame" class="iframeBox" allow="autoplay;fullscreen" sandbox="allow-scripts allow-same-origin allow-popups"></iframe><div class="note">⭐ StarHub Ads Bottom - if available • Linked: Play Store • Check Update • Remove Cache button available</div></div>
</div>

</div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import { getAuth, GoogleAuthProvider, signInWithPopup } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";
const cfg={apiKey:"AIzaSyA0p7V6pJKmAFiWM3je01g1iPXZzQYvEqI",authDomain:"starhubigdp.firebaseapp.com",projectId:"starhubigdp"};
const app=initializeApp(cfg); window.auth=getAuth(app);
window.loginOwner=async()=>{
 try{const p=new GoogleAuthProvider();p.addScope('https://www.googleapis.com/auth/drive.file');const r=await signInWithPopup(window.auth,p);document.getElementById('authStatus').innerText='👑 '+(r.user.displayName||'User');document.getElementById('driveAccounts').innerText=r.user.email+' - 15GB linked';document.getElementById('driveTotal').innerText='Total: 15GB + Device temp';checkQuota();}catch(e){alert('Enable Google Auth + Drive API');}
};
</script>
<script>
let curCat='All',adsMuted=false,dataSaver=false,currentQuality='auto';
const cats=['All','Android','iOS','PC','Console','VR','Games','Videos'];
let items=[
 {n:'Pokemon Unite',cat:'Games',platforms:['Android','iOS','PC'],u:'https://now.gg/apps/the-pokemon-company/5947/pokemon-unite.html',size:'6MB',free:true,provider:'now.gg',height:220},
 {n:'Free Fire Cloud',cat:'Games',platforms:['Android','PC'],u:'https://now.gg/apps/garena/13982/free-fire.html',size:'5MB',free:true,provider:'now.gg',height:240},
 {n:'Roblox',cat:'Games',platforms:['Android','iOS','PC','Console'],u:'https://now.gg/apps/roblox-corporation/5734/roblox.html',size:'6MB',free:true,provider:'now.gg',height:200},
 {n:'Guide Video',cat:'Videos',platforms:['Android','iOS','PC'],u:'https://www.youtube.com/embed/dQw4w9WgXcQ',size:'Video',free:true,provider:'YouTube',height:180}
];
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));}
function renderCats(){document.getElementById('catRow').innerHTML=cats.map(c=>`<span class="pill ${curCat===c?'on':''}" onclick="clickCat('${c}')">${esc(c)}</span>`).join('');}
window.clickCat=(c)=>{curCat=c;document.getElementById('q').value=c==='All'?'':c;document.getElementById('listTitle').innerText='📌 '+c+' - Related: Cloud + Play Store + YouTube';showDrop();renderCats();renderMain();}
renderCats();
window.showDrop=()=>{let q=(document.getElementById('q').value||'').toLowerCase();let d=document.getElementById('searchDrop');let rel=items.filter(i=>!q||i.n.toLowerCase().includes(q)).slice(0,6).map(i=>`<div class="note" style="padding:6px;cursor:pointer" onclick="document.getElementById('q').value='${esc(i.n)}';renderMain();">🔍 ${esc(i.n)} - Play Store + YouTube + Cloud</div>`).join('');d.innerHTML='<b>Google style - verified only</b>'+rel;d.style.display='block';}
window.onSearchInput=()=>{renderMain();showDrop();}
document.addEventListener('click',e=>{if(!document.getElementById('searchBox').contains(e.target))document.getElementById('searchDrop').style.display='none';});
function getBoxHTML(o){
 return `<div class="psBox" style="min-height:${o.height}px" onclick="openDetail('${esc(o.n)}')">
 <b>${esc(o.n)}</b> • ${esc(o.provider)}<br><span class="note">${o.platforms.join('/')} • ${esc(o.size)} • Device auto size</span><br>
 <span class="badge ${o.free?'':'paid'}">${o.free?'FREE Ad then Play':'PAID Pay then Play'}</span> <span class="badge">Android/iOS/PC</span>
 <div class="note" style="margin-top:6px">🔗 Related: <a href="https://play.google.com/store/search?q=${encodeURIComponent(o.n)}" target="_blank">Play Store • Check Update</a> • Size auto</div>
 <div style="display:flex;gap:6px;margin-top:6px"><button class="btn direct" onclick="event.stopPropagation();playGame('${o.u}','${esc(o.n)}')">☁️ Play on StarHub</button><button class="btn" style="background:#eef0f6" onclick="event.stopPropagation();window.open('https://play.google.com/store/search?q=${encodeURIComponent(o.n)}','_blank')">📥 Download then Play</button><button class="btn" style="background:#ffebeb;color:#d00" onclick="event.stopPropagation();removeCache('${esc(o.n)}')">🗑️ Remove Cache</button></div>
 </div>`;
}
window.renderMain=function(){
 let q=(document.getElementById('q').value||'').toLowerCase();
 let f=items.filter(o=>{if(curCat!=='All'&&!o.platforms.includes(curCat)&&o.cat!==curCat&&!o.n.toLowerCase().includes(curCat.toLowerCase()))return false;if(!q)return true;return o.n.toLowerCase().includes(q);});
 document.getElementById('masonryGrid').innerHTML=f.map(getBoxHTML).join('')||'<span class="note">No results - Try All</span>';
}
window.openDetail=(name)=>{
 const o=items.find(x=>x.n===name);document.getElementById('q').value=name;document.getElementById('listTitle').innerText='🔍 '+name+' - Every results: Cloud + Play Store + YouTube';
 const s=document.getElementById('detailSection');s.style.display='block';
 s.innerHTML=`<h3>${esc(o.n)} - ${o.platforms.join(', ')}</h3><div class="note">Verified: ${esc(o.provider)} - Legal embed. Free=Ad then Play, Paid=Pay then Play on provider. Guest=No save, Login=Old profile restore via Google. Quality selector + Data Saver works on your network, not tower boost.</div>
 <div style="display:flex;gap:6px;margin-top:8px"><button class="btn direct" onclick="playGame('${o.u}','${esc(o.n)}')">☁️ Play Now</button><button class="btn" style="background:#eef0f6" onclick="window.open('https://play.google.com/store/search?q=${encodeURIComponent(o.n)}','_blank')">📱 Open Play Store</button><button class="btn" style="background:#ffebeb;color:#d00" onclick="removeCache('${esc(o.n)}')">🗑️ Remove Cache</button></div>`;
 s.scrollIntoView({behavior:'smooth'});renderMain();
}
window.playGame=(u,t)=>{const p=document.getElementById('player'),fr=document.getElementById('frame');p.style.display='block';document.getElementById('pTitle').innerText='☁️ '+t+' - By StarHub | Powered by now.gg | Quality: '+currentQuality;fr.src=u;p.scrollIntoView({behavior:'smooth'});}
window.removeCache=(id)=>{alert('Temp cache removed - IndexedDB store cleared. Play Store install still there.');}
window.toggleMute=()=>{adsMuted=!adsMuted;document.getElementById('adsToggle').innerText=adsMuted?'🔇 Ads Off':'🔊 Ads On';}
window.setQuality=(q)=>{currentQuality=q;document.getElementById('dataInfo').innerText='Quality: '+q+' | Est: '+(q==='1080'?'3GB':q==='720'?'1.5GB':q==='480'?'0.7GB':'0.3GB')+'/hr - Real: auto switch if net weak';localStorage.setItem('starhubQuality',q);}
window.setGraphics=(g)=>{document.getElementById('dataInfo').innerText='Graphics: '+g+' - Change inside game Settings > Graphics';}
window.toggleDataSaver=()=>{dataSaver=!dataSaver;document.getElementById('dataSaverBtn').innerText=dataSaver?'📉 Data Saver: ON':'📉 Data Saver: Off';if(dataSaver)setQuality('480');}
async function checkQuota(){if(navigator.storage&&navigator.storage.estimate){const {usage,quota}=await navigator.storage.estimate();document.getElementById('deviceQuota').innerText=`Used ${(usage/1024/1024).toFixed(1)}MB / ${(quota/1024/1024).toFixed(1)}MB - 1 IndexedDB only`;}}
checkQuota();renderMain();
if(navigator.connection){navigator.connection.addEventListener('change',()=>{if(dataSaver||currentQuality==='auto'){if(navigator.connection.downlink<1.5)setQuality('240');else if(navigator.connection.downlink<3)setQuality('480');else setQuality('720');}});}
let saved=localStorage.getItem('starhubQuality');if(saved)setQuality(saved);
</script>
</body></html>
