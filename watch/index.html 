<!doctype html><html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>StarHub Watch - YouTube Watch</title><link rel="icon" href="/favicon.ico"/><link rel="manifest" href="/manifest.json"/><style>body{margin:0;background:#000;color:#fff;font-family:system-ui}header{position:sticky;top:0;background:#111;padding:10px 12px;display:flex;gap:8px;z-index:10}.player{aspect-ratio:16/9;background:#111;display:flex;align-items:center;justify-content:center;font-size:20px}.info{padding:12px}.actions{display:flex;gap:8px;overflow:auto;padding:8px 12px}button{background:#222;border:1px solid #333;color:#fff;border-radius:999px;padding:8px 12px;white-space:nowrap}.card{padding:12px;border-bottom:1px solid #222;display:flex;gap:12px}.card img{width:120px;aspect-ratio:16/9;border-radius:8px;background:#222}</style></head><body>
<header><button onclick="history.back()">←</button><div id="title">Watch</div><button onclick="location.href='/library/'">Library</button></header>
<div class="player" id="player">▶️ Player - Auto 122+ 133± WIN - Rotate shadow ripple vibrate confetti tick long press preview swipe haptics - Feel best</div>
<div class="info" id="info"></div>
<div class="actions"><button>Like</button><button>Save</button><button>Playlist</button><button>Share</button><button>Report</button><button>Hype</button><button>Super Thanks</button><button>Membership</button></div>
<div id="grid"></div>
<script type="module">
import FM from '/lib/feature-manager.js';import {saveWatchLater,saveLikes} from '/lib/storage.js';import {checkLaw} from '/lib/law.js';
const v=new URLSearchParams(location.search).get('v')||'auto-122';document.getElementById('title').innerText=v;
const law=checkLaw(v);document.getElementById('info').innerHTML=`<b>${v} - Title Dev Views Likes</b><br><small>${law.area} • ${law.law} • ${FM.getStatus().version} • free safe legal • valid specified unspec universal • Comments For you Library Subs Bell Hype</small>`;
document.getElementById('player').innerHTML=`▶️ ${v} - Video player - Thumb 16/9 Time 2:17 Av 36px round - Rotate shadow - ${law.area}`;
async function load(){const r=await fetch(`/api/search?q=${encodeURIComponent(v)}`);const j=await r.json();document.getElementById('grid').innerHTML=(j.results||[]).map(x=>`<div class="card" onclick="location.href='/watch/?v=${x.id}'"><img src="/api/thumbnail?id=${x.id}&w=200"><div><b>${x.id}</b><br><small>For you • GENIUS views • ${x.type||'video'}</small></div></div>`).join('');}
load();window.saveWatchLater=saveWatchLater;window.saveLikes=saveLikes;
if('serviceWorker' in navigator){navigator.serviceWorker.register('/sw.js').catch(()=>{});}
</script></body></html>