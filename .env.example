WEEK_TOTAL=52
MONTH_TOTAL=12
MONTHS=Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec
FILTER_2026=true
DAY_WISE=true
WEEK_WISE=true
MONTH_WISE=true

# === SECURITY - CSP HSTS - PRODUCTION READY ===
