{
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "installCommand": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {"key": "Content-Type", "value": "application/json; charset=utf-8"},
        {"key": "Cache-Control", "value": "public, max-age=60, stale-while-revalidate=600, s-maxage=86400"},
        {"key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload"},
        {"key": "Content-Security-Policy", "value": "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"},
        {"key": "Cross-Origin-Opener-Policy", "value": "same-origin"},
        {"key": "Cross-Origin-Embedder-Policy", "value": "require-corp"},
        {"key": "Cross-Origin-Resource-Policy", "value": "same-origin"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "X-XSS-Protection", "value": "1; mode=block"},
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet, noimageindex"},
        {"key": "X-No-Transaction", "value": "true"},
        {"key": "X-No-Payment-Gateway", "value": "true"},
        {"key": "X-QR-Separate", "value": "true"},
        {"key": "X-No-PII", "value": "true"},
        {"key": "X-Hash-Only", "value": "true"},
        {"key": "X-PII-Zero", "value": "true"},
        {"key": "X-Hash-256", "value": "true"},
        {"key": "X-Universal", "value": "true"},
        {"key": "X-Universal-Auto", "value": "true"},
        {"key": "X-No-Specify", "value": "true"},
        {"key": "X-Unspecified-Universal", "value": "true"},
        {"key": "X-Akela", "value": "true"},
        {"key": "X-Akela-Work", "value": "true"},
        {"key": "X-Sab-Ka-Sath-Work", "value": "true"},
        {"key": "X-No-Ping", "value": "true"},
        {"key": "X-Secretly", "value": "true"},
        {"key": "X-Private-Protection-Universal", "value": "true"},
        {"key": "X-Owner-Net-Off-Working", "value": "true"},
        {"key": "X-Any-Problem-Auto", "value": "true"},
        {"key": "X-Global-Law-Auto", "value": "true"},
        {"key": "X-Feature-Right", "value": "true"},
        {"key": "X-Past-Present-Future-Safe", "value": "true"},
        {"key": "X-Past", "value": "safe"},
        {"key": "X-Present", "value": "safe"},
        {"key": "X-Future", "value": "safe"},
        {"key": "X-Legal-Safe", "value": "true"},
        {"key": "X-Real-Protection", "value": "true"},
        {"key": "X-Auto-Adjustable", "value": "true"},
        {"key": "X-Real-Time-Laws", "value": "true"},
        {"key": "X-Filter-Valid", "value": "true"},
        {"key": "X-Filter-Secure", "value": "true"},
        {"key": "X-Secretly-Secure", "value": "true"},
        {"key": "X-Privacy-Protection", "value": "true"},
        {"key": "X-Security-Best", "value": "true"},
        {"key": "X-DPDP-Safe", "value": "true"},
        {"key": "X-GDPR-Safe", "value": "true"},
        {"key": "X-FCRA-Safe", "value": "true"},
        {"key": "X-FTC-Safe", "value": "true"},
        {"key": "Access-Control-Allow-Origin", "value": "*"},
        {"key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS"},
        {"key": "Access-Control-Max-Age", "value": "86400"}
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {"key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "SAMEORIGIN"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"},
        {"key": "X-Akela", "value": "true"},
        {"key": "X-No-Ping", "value": "true"},
        {"key": "X-Secretly", "value": "true"},
        {"key": "X-Private-Protection-Universal", "value": "true"},
        {"key": "X-Universal", "value": "true"},
        {"key": "X-Past-Present-Future-Safe", "value": "true"},
        {"key": "X-Global-Law-Auto", "value": "true"},
        {"key": "X-Legal-Safe", "value": "true"},
        {"key": "Cache-Control", "value": "public, max-age=60, s-maxage=86400, stale-while-revalidate"}
      ]
    }
  ],
  "rewrites": [
    {"source": "/api/sitemap.xml", "destination": "/api/sitemap.xml.js"},
    {"source": "/api/sitemap", "destination": "/api/sitemap.xml.js"},
    {"source": "/sitemap.xml", "destination": "/api/sitemap.xml.js"},
    {"source": "/robots.txt", "destination": "/api/sitemap.xml.js?robots=1"},
    {"source": "/api/health", "destination": "/api/health.js"},
    {"source": "/api/affiliate", "destination": "/api/affiliate.js"},
    {"source": "/api/donation", "destination": "/api/donation.js"},
    {"source": "/api", "destination": "/api/index.js"},
    {"source": "/api/", "destination": "/api/index.js"},
    {"source": "/api/all", "destination": "/api/[...all].js"},
    {"source": "/api/:num(\\d+)", "destination": "/api/[...all].js"},
    {"source": "/(.*)", "destination": "/api/[...all].js"}
  ],
  "redirects": [],
  "functions": {
    "api/[...all].js": {"maxDuration": 10, "memory": 128},
    "api/affiliate.js": {"maxDuration": 10, "memory": 128},
    "api/donation.js": {"maxDuration": 10, "memory": 128},
    "api/index.js": {"maxDuration": 5, "memory": 128},
    "api/sitemap.xml.js": {"maxDuration": 5, "memory": 128},
    "api/health.js": {"maxDuration": 5, "memory": 128}
  },
  "regions": ["bom1", "sin1", "dub1", "iad1", "hnd1", "sfo1", "cle1", "gru1", "syd1"],
  "github": {"silent": true},
  "crons": [],
  "env": {
    "LAW_VERSION": "2026-10-30",
    "DPDP_VERSION": "DPDP Act 2023 + Rules 2025",
    "GDPR_VERSION": "GDPR 2018",
    "FCRA_VERSION": "FCRA Act 2010 + Amendment 2020",
    "FTC_VERSION": "FTC 16 CFR Part 255",
    "ASCI_VERSION": "ASCI Guidelines 2024",
    "PMLA_VERSION": "PMLA Act 2002 Sec 12",
    "BANNED_COUNTRIES": "",
    "DONATION_ENABLED": "true",
    "AFFILIATE_ENABLED": "true",
    "AUTO_HIDE": "true",
    "RATE_LIMIT": "10/min",
    "COST_ZERO": "true",
    "PII_ZERO": "true"
  }
}