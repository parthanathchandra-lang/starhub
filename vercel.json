{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "installCommand": null,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/games", "destination": "/index.html" },
    { "source": "/games/:path*", "destination": "/index.html" },
    { "source": "/videos/:path*", "destination": "/index.html" },
    { "source": "/creators/:path*", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; frame-src https://www.youtube.com https://store.steampowered.com; form-action 'none'; payment-src 'none';" },
        { "key": "X-Real-Basis", "value": "100% Real - No Fake - Free Only Locked - PAID_ENABLED=false - No specific ads" },
        { "key": "X-Privacy", "value": "no-cookie - DPDP GDPR safe" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer-when-downgrade" }
      ]
    }
  ]
}