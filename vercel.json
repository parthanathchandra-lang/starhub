{
  "cleanUrls": true,
  "rewrites": [{ "source": "/(.*)", "destination": "/api/[...all]" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=86400, stale-while-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Akela", "value": "true" },
        { "key": "X-No-Ping", "value": "true" },
        { "key": "X-Secretly", "value": "true" },
        { "key": "X-Private-Protection-Universal", "value": "true" },
        { "key": "X-Owner-Net-Off-Working", "value": "true" }
      ]
    }
  ]
}